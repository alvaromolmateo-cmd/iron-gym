{
  "name": "despliegue",
  "image": "mcr.microsoft.com/devcontainers/php:8.4",
  "containerEnv": {
    "XDEBUG_MODE": "off"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Backend Laravel" }
  },
  "postCreateCommand": "sudo git config --system --add safe.directory \"${containerWorkspaceFolder}\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "laravel.vscode-laravel",
        "bmewburn.vscode-intelephense-client",
        "humao.rest-client"
      ]
    }
  }
}
