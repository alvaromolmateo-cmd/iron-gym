# Copia este archivo a .env (cp .env.example .env) y ajusta los valores.
# El archivo .env NO se sube al repositorio.

# --- Backend (Django) ---
# Clave secreta de Django. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave
# True en local, False en producción
DJANGO_DEBUG=True
# Hosts permitidos, separados por comas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes del frontend que pueden llamar a la API, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) ---
# URL base de la API que consume el frontend
VITE_API_URL=http://localhost:8000/api
